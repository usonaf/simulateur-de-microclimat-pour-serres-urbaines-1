    "document_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Simulateur de Microclimat pour Serres Urbaines | Paramètres de votre serre</title>\n    <meta name=\"description\" content=\"Évaluez et optimisez les conditions de température, humidité et lumière pour vos cultures en serre urbaine, en tenant compte des spécificités locales et des périodes de l\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400&display=swap');\n\n        :root {\n            --color-primary: #34495e;\n            --color-secondary: #2c3e50;\n            --color-accent: #2ecc71;\n            --color-background: #ecf0f1;\n            --color-text: #2c3e50;\n            --color-light-text: #7f8c8d;\n            --color-border: #bdc3c7;\n            --font-display: 'IBM Plex Sans', sans-serif;\n            --font-body: 'IBM Plex Sans', sans-serif;\n            --font-mono: 'IBM Plex Mono', monospace;\n        }\n\n        body {\n            font-family: var(--font-body);\n            color: var(--color-text);\n            background-color: var(--color-background);\n            margin: 0;\n            line-height: 1.6;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding: 20px;\n        }\n\n        .container {\n            max-width: 960px;\n            width: 100%;\n            background-color: #fff;\n            padding: 40px 60px;\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\n            border-radius: 8px;\n            margin-bottom: 30px;\n            box-sizing: border-box;\n            border: 1px solid var(--color-border);\n        }\n\n        h1, h2, h3 {\n            font-family: var(--font-display);\n            color: var(--color-primary);\n            font-weight: 600;\n            letter-spacing: -0.02em;\n        }\n\n        h1 {\n            font-size: 3.2em;\n            margin-bottom: 0.2em;\n            line-height: 1.1;\n        }\n\n        h2 {\n            font-size: 2em;\n            border-bottom: 2px solid var(--color-accent);\n            padding-bottom: 10px;\n            margin-top: 40px;\n            margin-bottom: 25px;\n        }\n\n        p {\n            margin-bottom: 1em;\n        }\n\n        .intro {\n            font-size: 1.2em;\n            color: var(--color-light-text);\n            margin-top: 0;\n            margin-bottom: 40px;\n        }\n\n        .form-group {\n            margin-bottom: 20px;\n            display: flex;\n            flex-direction: column;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 8px;\n            font-weight: 600;\n            color: var(--color-secondary);\n            font-family: var(--font-mono);\n            font-size: 0.9em;\n            text-transform: uppercase;\n        }\n\n        input[type=\"number\"],\n        input[type=\"text\"],\n        select {\n            width: 100%;\n            padding: 12px;\n            border: 1px solid var(--color-border);\n            border-radius: 5px;\n            font-family: var(--font-body);\n            font-size: 1em;\n            box-sizing: border-box;\n            background-color: #fcfcfc;\n        }\n\n        input[type=\"range\"] {\n            width: 100%;\n            -webkit-appearance: none;\n            height: 8px;\n            background: var(--color-border);\n            border-radius: 5px;\n            outline: none;\n            opacity: 0.7;\n            transition: opacity .2s;\n        }\n\n        input[type=\"range\"]:hover {\n            opacity: 1;\n        }\n\n        input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            appearance: none;\n            width: 20px;\n            height: 20px;\n            border-radius: 50%;\n            background: var(--color-accent);\n            cursor: pointer;\n            border: 2px solid #fff;\n        }\n\n        input[type=\"range\"]::-moz-range-thumb {\n            width: 20px;\n            height: 20px;\n            border-radius: 50%;\n            background: var(--color-accent);\n            cursor: pointer;\n            border: 2px solid #fff;\n        }\n        .range-value {\n            font-family: var(--font-mono);\n            font-size: 0.9em;\n            color: var(--color-light-text);\n            margin-top: 5px;\n        }\n\n        button {\n            background-color: var(--color-accent);\n            color: white;\n            padding: 15px 30px;\n            border: none;\n            border-radius: 5px;\n            font-size: 1.1em;\n            font-weight: 600;\n            cursor: pointer;\n            transition: background-color 0.3s ease;\n            width: auto;\n            margin-top: 20px;\n        }\n\n        button:hover {\n            background-color: #27ae60;\n        }\n\n        #tool-result {\n            margin-top: 40px;\n            padding: 30px;\n            background-color: #f9f9f9;\n            border: 1px dashed var(--color-accent);\n            border-radius: 8px;\n            min-height: 150px;\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n        }\n\n        .result-section {\n            margin-bottom: 20px;\n        }\n\n        .result-section h3 {\n            font-size: 1.5em;\n            color: var(--color-primary);\n            margin-bottom: 10px;\n        }\n\n        .result-item {\n            display: flex;\n            justify-content: space-between;\n            padding: 8px 0;\n            border-bottom: 1px dotted var(--color-border);\n        }\n\n        .result-item:last-child {\n            border-bottom: none;\n        }\n\n        .result-label {\n            font-weight: 600;\n            color: var(--color-secondary);\n        }\n\n        .result-value {\n            font-family: var(--font-mono);\n            color: var(--color-text);\n        }\n\n        .graph-placeholder {\n            width: 100%;\n            height: 200px;\n            background-color: #e0e0e0;\n            border-radius: 5px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-light-text);\n            font-family: var(--font-mono);\n            font-size: 0.9em;\n            margin-top: 15px;\n            border: 1px dashed var(--color-border);\n        }\n\n        .seo-section {\n            margin-top: 60px;\n            padding: 30px;\n            background-color: var(--color-secondary);\n            color: #fff;\n            border-radius: 8px;\n            line-height: 1.7;\n        }\n\n        .seo-section h3 {\n            color: var(--color-accent);\n            margin-bottom: 20px;\n        }\n\n        .seo-section a {\n            color: var(--color-accent);\n            text-decoration: none;\n        }\n\n        .seo-section a:hover {\n            text-decoration: underline;\n        }\n\n        .grid-columns {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n        }\n        @media (max-width: 768px) {\n            .container {\n                padding: 30px;\n            }\n            h1 {\n                font-size: 2.5em;\n            }\n            .intro {\n                font-size: 1.1em;\n            }\n            .grid-columns {\n                grid-template-columns: 1fr;\n            }\n        }\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2em;\n            }\n            .intro {\n                font-size: 1em;\n            }\n            .container {\n                padding: 20px;\n            }\n        }\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://simulateur-de-microclimat-pour-serres-urbaines-1.onrender.com\">\n    <meta property=\"og:title\" content=\"Simulateur de Microclimat pour Serres Urbaines\">\n    <meta property=\"og:description\" content=\"Évaluez et optimisez les conditions de température, humidité et lumière pour vos cultures en serre urbaine, en tenant compte des spécificités locales et des périodes de l\">\n    <meta property=\"og:url\" content=\"https://simulateur-de-microclimat-pour-serres-urbaines-1.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Simulateur de Microclimat pour Serres Urbaines\", \"description\": \"Évaluez et optimisez les conditions de température, humidité et lumière pour vos cultures en serre urbaine, en tenant compte des spécificités locales et des périodes de l\", \"url\": \"https://simulateur-de-microclimat-pour-serres-urbaines-1.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"simulateur-de-microclimat-pour-serres-urbaines-1\" data-runtime-mode=\"generic_calculator\">\n    <div class=\"container\">\n        <h1>Simulateur de Microclimat pour Serres Urbaines</h1>\n        <p class=\"intro\">\n            Évaluez et optimisez les conditions de température, humidité et lumière pour vos cultures en serre urbaine, en tenant compte des spécificités locales et des périodes de l'année. Idéal pour maximiser votre rendement.\n        </p>\n\n        <form id=\"tool-form\">\n            <h2>Paramètres de votre serre</h2>\n            <div class=\"grid-columns\">\n                <div class=\"form-group\">\n                    <label for=\"location\">Localisation (Ville)</label>\n                    <input type=\"text\" id=\"location\" value=\"Paris\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"month\">Mois de l'année</label>\n                    <select id=\"month\" required>\n                        <option value=\"1\">Janvier</option>\n                        <option value=\"2\">Février</option>\n                        <option value=\"3\">Mars</option>\n                        <option value=\"4\">Avril</option>\n                        <option value=\"5\">Mai</option>\n                        <option value=\"6\">Juin</option>\n                        <option value=\"7\" selected>Juillet</option>\n                        <option value=\"8\">Août</option>\n                        <option value=\"9\">Septembre</option>\n                        <option value=\"10\">Octobre</option>\n                        <option value=\"11\">Novembre</option>\n                        <option value=\"12\">Décembre</option>\n                    </select>\n                </div>\n            </div>\n\n            <div class=\"grid-columns\">\n                <div class=\"form-group\">\n                    <label for=\"greenhouse-type\">Type de Serre</label>\n                    <select id=\"greenhouse-type\" required>\n                        <option value=\"small-plastic\">Petite (plastique)</option>\n                        <option value=\"medium-glass\">Moyenne (verre)</option>\n                        <option value=\"large-polycarbonate\">Grande (polycarbonate)</option>\n                    </select>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"crop-type\">Type de Culture</label>\n                    <select id=\"crop-type\" required>\n                        <option value=\"herbs\">Herbes aromatiques</option>\n                        <option value=\"leafy-greens\">Légumes feuilles</option>\n                        <option value=\"fruiting-veg\">Légumes fruits</option>\n                    </select>\n                </div>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"target-temp\">Température cible souhaitée (°C)</label>\n                <input type=\"range\" id=\"target-temp\" min=\"10\" max=\"35\" value=\"22\" oninput=\"document.getElementById('target-temp-value').innerText=this.value+'°C'\">\n                <span id=\"target-temp-value\" class=\"range-value\">22°C</span>\n            </div>\n\n            <div class=\"form-group\">\n                <label for=\"target-humidity\">Humidité cible souhaitée (%)</label>\n                <input type=\"range\" id=\"target-humidity\" min=\"30\" max=\"90\" value=\"65\" oninput=\"document.getElementById('target-humidity-value').innerText=this.value+'%'\">\n                <span id=\"target-humidity-value\" class=\"range-value\">65%</span>\n            </div>\n\n            <button type=\"submit\" id=\"tool-submit\" data-affiliate-slot=\"simulation-action\">Lancer la Simulation</button>\n        </form>\n\n        <div id=\"tool-result\">\n            <h3 id=\"result-headline\">Résultats de la simulation</h3>\n            <p style=\"text-align: center; color: var(--color-light-text);\">\n                Veuillez remplir le formulaire ci-dessus et lancer la simulation pour voir vos recommandations.\n            </p>\n        </div>\n    </div>\n\n    <div class=\"container seo-section\">\n        <h3>Optimisez Votre Serre Urbaine avec Précision</h3>\n        <p>\n            Que vous soyez un jardinier urbain débutant ou un producteur aguerri, comprendre et maîtriser le microclimat de votre <a href=\"#\" data-affiliate-slot=\"seo-serre-urbaine\">serre urbaine</a> est crucial. Notre simulateur vous aide à anticiper les défis et à mettre en place les solutions adaptées pour une croissance optimale de vos <a href=\"#\" data-affiliate-slot=\"seo-cultures\">cultures</a>. Fini les approximations !\n        </p>\n        <p>\n            Découvrez comment la <a href=\"#\" data-affiliate-slot=\"seo-temperature\">température</a>, l'humidité et l'intensité lumineuse interagissent avec votre <a href=\"#\" data-affiliate-slot=\"seo-local\">environnement local</a>. Obtenez des <a href=\"#\" data-affiliate-slot=\"seo-recommandations\">recommandations personnalisées</a> pour l'irrigation, la ventilation et l'éclairage. Notre outil est indispensable pour tout projet d'agriculture urbaine en <a href=\"#\" data-affiliate-slot=\"seo-france\">France</a>, que vous cultiviez des <a href=\"#\" data-affiliate-slot=\"seo-tomates\">tomates</a> sur un balcon parisien ou des <a href=\"#\" data-affiliate-slot=\"seo-herbes\">herbes aromatiques</a> sur un toit lyonnais.\n        </p>\n        <p>\n            Évitez les maladies, maximisez vos récoltes et contribuez à une agriculture plus durable. Essayez notre <a href=\"#\" data-affiliate-slot=\"seo-simulateur-gratuit\">simulateur de microclimat gratuit</a> dès aujourd'hui et transformez votre espace vert en un écosystème productif !\n        </p>\n    </div>\n\n    <script>\n        document.getElementById('tool-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n            const location = document.getElementById('location').value;\n            const month = parseInt(document.getElementById('month').value);\n            const greenhouseType = document.getElementById('greenhouse-type').value;\n            const cropType = document.getElementById('crop-type').value;\n            const targetTemp = parseInt(document.getElementById('target-temp').value);\n            const targetHumidity = parseInt(document.getElementById('target-humidity').value);\n\n            let recommendations = [];\n            let simulatedTemp = targetTemp + (Math.random() * 4 - 2); // +/- 2 degrees\n            let simulatedHumidity = targetHumidity + (Math.random() * 10 - 5); // +/- 5%\n            let simulatedLight = 0;\n\n            // Base climate data (simplified for demonstration)\n            const monthData = {\n                1: { temp: 5, light: 5, humidity: 85 }, // Janvier\n                2: { temp: 6, light: 6, humidity: 80 },\n                3: { temp: 9, light: 8, humidity: 75 },\n                4: { temp: 12, light: 10, humidity: 70 },\n                5: { temp: 16, light: 12, humidity: 65 },\n                6: { temp: 19, light: 14, humidity: 60 },\n                7: { temp: 21, light: 14, humidity: 58 }, // Juillet\n                8: { temp: 20, light: 13, humidity: 62 },\n                9: { temp: 17, light: 11, humidity: 70 },\n                10: { temp: 13, light: 8, humidity: 78 },\n                11: { temp: 8, light: 6, humidity: 82 },\n                12: { temp: 6, light: 5, humidity: 85 }\n            };\n            const currentMonthData = monthData[month];\n\n            // Adjustments based on greenhouse type\n            let tempInsulation = 0;\n            let humidityRetention = 0;\n            let lightTransmission = 0;\n            switch (greenhouseType) {\n                case 'small-plastic':\n                    tempInsulation = 3; humidityRetention = 10; lightTransmission = 0.8; break;\n                case 'medium-glass':\n                    tempInsulation = 5; humidityRetention = 5; lightTransmission = 0.9; break;\n                case 'large-polycarbonate':\n                    tempInsulation = 7; humidityRetention = 8; lightTransmission = 0.85; break;\n            }\n\n            simulatedTemp = currentMonthData.temp + tempInsulation + (Math.random() * 3 - 1.5);\n            simulatedHumidity = currentMonthData.humidity + humidityRetention + (Math.random() * 8 - 4);\n            simulatedLight = currentMonthData.light * lightTransmission + (Math.random() * 2 - 1); // Hours of effective light\n\n            // Adjustments based on crop type & target\n            let idealTempRange = [20, 25];\n            let idealHumidityRange = [60, 75];\n            let idealLightHours = 12;\n\n            switch (cropType) {\n                case 'herbs':\n                    idealTempRange = [18, 24]; idealHumidityRange = [55, 70]; idealLightHours = 10; break;\n                case 'leafy-greens':\n                    idealTempRange = [15, 22]; idealHumidityRange = [60, 80]; idealLightHours = 12; break;\n                case 'fruiting-veg':\n                    idealTempRange = [22, 28]; idealHumidityRange = [50, 65]; idealLightHours = 14; break;\n            }\n\n            // Generate recommendations\n            if (simulatedTemp < idealTempRange[0] - 2) {\n                recommendations.push(\"Augmenter le chauffage ou améliorer l'isolation.\");\n            } else if (simulatedTemp > idealTempRange[1] + 2) {\n                recommendations.push(\"Améliorer la ventilation ou ombrager la serre.\");\n            } else {\n                recommendations.push(\"La température est bonne, maintenir la surveillance.\");\n            }\n\n            if (simulatedHumidity < idealHumidityRange[0] - 5) {\n                recommendations.push(\"Augmenter l'humidité (vaporisation, humidificateur).\");\n            } else if (simulatedHumidity > idealHumidityRange[1] + 5) {\n                recommendations.push(\"Réduire l'humidité (ventilation, déshumidificateur).\");\n            } else {\n                recommendations.push(\"L'humidité est optimale, peu d'ajustements requis.\");\n            }\n\n            if (simulatedLight < idealLightHours - 3) {\n                recommendations.push(\"Installer un éclairage d'appoint (LED horticoles).\");\n            } else if (simulatedLight > idealLightHours + 3) {\n                recommendations.push(\"Prévoir un ombrage durant les heures les plus intenses.\");\n            } else {\n                recommendations.push(\"L'apport lumineux est adéquat.\");\n            }\n\n            if (recommendations.length === 0) {\n                recommendations.push(\"Les conditions microclimatiques sont idéales pour votre culture!\");\n            }\n\n            const resultHtml = `\n                <div class=\"result-section\">\n                    <h3>Conditions Actuelles Simuléées (${location}, ${document.getElementById('month').options[month-1].text})</h3>\n                    <div class=\"result-item\"><span class=\"result-label\">Température moyenne:</span> <span class=\"result-value\">${simulatedTemp.toFixed(1)}°C</span></div>\n                    <div class=\"result-item\"><span class=\"result-label\">Humidité relative:</span> <span class=\"result-value\">${simulatedHumidity.toFixed(0)}%</span></div>\n                    <div class=\"result-item\"><span class=\"result-label\">Luminosité (heures effectives):</span> <span class=\"result-value\">${simulatedLight.toFixed(1)}h</span></div>\n                </div>\n                <div class=\"result-section\">\n                    <h3>Recommandations Personnalisées</h3>\n                    ${recommendations.map(r => `<div class=\"result-item\"><span class=\"result-value\">➡️ ${r}</span></div>`).join('')}\n                </div>\n                <div class=\"result-section\">\n                    <h3>Visualisation des Données</h3>\n                    <div class=\"graph-placeholder\">Graphique de simulation (température, humidité, lumière sur 24h)</div>\n                </div>\n            `;\n            document.getElementById('tool-result').innerHTML = resultHtml;\n        });\n    </script>\n<div id=\"qa-smoke-result\" hidden></div>\n<script id=\"farmbuilder-affiliate-helper\">\n(function () {\n  window.__UTILITY_AFFILIATE_MAP = window.__UTILITY_AFFILIATE_MAP || {};\n  document.addEventListener(\"click\", function (event) {\n    const target = event.target.closest(\"[data-affiliate-slot]\");\n    if (!target) return;\n    const slot = target.getAttribute(\"data-affiliate-slot\");\n    const href = window.__UTILITY_AFFILIATE_MAP[slot];\n    if (!href) return;\n    if (target.tagName && target.tagName.toLowerCase() === \"a\") {\n      target.setAttribute(\"href\", href);\n      target.removeAttribute(\"rel\");\n      return;\n    }\n    event.preventDefault();\n    window.open(href, \"_blank\");\n  }, true);\n})();\n</script>\n<script id=\"farmbuilder-functional-qa\">\n(function () {\n  function marker() {\n    let node = document.getElementById(\"qa-smoke-result\");\n    if (node) return node;\n    node = document.createElement(\"div\");\n    node.id = \"qa-smoke-result\";\n    node.hidden = true;\n    document.body.appendChild(node);\n    return node;\n  }\n\n  let qaFinished = false;\n  let qaWatchdog = null;\n\n  function normalize(text) {\n    return String(text || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function findForm() {\n    return document.getElementById(\"tool-form\") || document.querySelector(\"form\");\n  }\n\n  function findResult() {\n    return (\n      document.getElementById(\"tool-result\") ||\n      document.querySelector(\"[data-result]\") ||\n      document.querySelector(\".tool-result, .result-card, .result, .results, .output, .preview, .diagnostic, .analysis\")\n    );\n  }\n\n  function primaryAction(form) {\n    if (!form) return null;\n    return (\n      document.getElementById(\"tool-submit\") ||\n      form.querySelector(\"#tool-submit\") ||\n      form.querySelector(\"[data-primary-action]\") ||\n      form.querySelector(\"button[type=submit]\") ||\n      form.querySelector(\"button\") ||\n      form.querySelector(\"input[type=submit]\")\n    );\n  }\n\n  function resultSignature(node) {\n    if (!node) return \"\";\n    const text = normalize(node.textContent);\n    const html = normalize(node.innerHTML).slice(0, 600);\n    return `${text}||${html}`;\n  }\n\n  function resultHeadline(node) {\n    if (!node) return \"\";\n    const heading = node.querySelector(\"h1, h2, h3, strong, b\");\n    return normalize(heading ? heading.textContent : \"\");\n  }\n\n  function sampleText(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"} ${field.placeholder || \"\"}`.toLowerCase();\n    if (/email/.test(key)) return \"bonjour@example.com\";\n    if (/url|site|website|lien/.test(key)) return \"https://example.com/offre-solaire\";\n    if (/phone|tel|mobile/.test(key)) return \"0612345678\";\n    if (/ville|city|localisation|location|region|departement|postal/.test(key)) return \"Paris\";\n    if (/orientation/.test(key)) return \"sud\";\n    if (/keyword|theme|topic|sujet|subject/.test(key)) return \"energie solaire domestique\";\n    if (/titre|title/.test(key)) return \"Simulateur solaire maison\";\n    if (/nom|name|project/.test(key)) return \"Projet Horizon\";\n    if (/description|notes|content|message/.test(key)) return \"Maison individuelle exposee sud avec toiture exploitable.\";\n    return field.placeholder || \"France\";\n  }\n\n  function sampleNumber(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"}`.toLowerCase();\n    if (/inclinaison|angle|slope/.test(key)) return \"30\";\n    if (/surface|size|m2|sqm/.test(key)) return \"28\";\n    if (/annee|year/.test(key)) return \"2024\";\n    if (/prix|price|budget|cost|amount|montant/.test(key)) return \"12000\";\n    const min = Number(field.min || \"\");\n    const max = Number(field.max || \"\");\n    if (Number.isFinite(min) && Number.isFinite(max) && max >= min) {\n      return String(Math.min(max, Math.max(min, min + Math.round((max - min) * 0.35))));\n    }\n    if (Number.isFinite(min)) return String(Math.max(min, 12));\n    if (Number.isFinite(max)) return String(Math.min(max, 12));\n    return field.value || \"12\";\n  }\n\n  function applySample(field) {\n    const tag = (field.tagName || \"\").toLowerCase();\n    const type = (field.type || \"\").toLowerCase();\n    if (field.disabled) return;\n    if (type === \"hidden\" || type === \"submit\" || type === \"button\" || type === \"reset\" || type === \"image\" || type === \"file\") {\n      return;\n    }\n    const currentValue = normalize(field.value);\n    if (tag === \"select\") {\n      if (currentValue) return;\n      const option = Array.from(field.opti